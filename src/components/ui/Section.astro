---
type Props = {
  id?: string
  tone?: "paper" | "cream" | "dark"
  title?: string
  intro?: string
  centered?: boolean
  class?: string
}

const { id, tone = "paper", title, intro, centered = false, class: className = "" } = Astro.props

const toneClasses = {
  paper: "bg-cream-50 text-bark-800",
  cream: "bg-cream-100 text-bark-800",
  dark: "bg-bark-900 text-cream-100",
} satisfies Record<NonNullable<Props["tone"]>, string>

const headingClasses = tone === "dark" ? "text-cream-50" : "text-bark-900"
const introClasses = tone === "dark" ? "text-cream-200" : "text-bark-700"
---

<section id={id} class={`${toneClasses[tone]} px-6 py-20 sm:py-28 ${className}`}>
  <div class="mx-auto max-w-6xl">
    {
      (title || intro) && (
        <header class={`mb-12 sm:mb-16 ${centered ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}`}>
          {title && (
            <h2 class={`text-3xl font-semibold sm:text-4xl ${headingClasses}`}>{title}</h2>
          )}
          {intro && <p class={`mt-4 text-lg leading-relaxed ${introClasses}`}>{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
