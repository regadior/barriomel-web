---
import Section from "@/components/ui/Section.astro"
import { galleryPhotoKeys, photos } from "@/data/photos"
import type { Locale } from "@/i18n/config"
import { dictionaryFor } from "@/i18n/dictionaries"
import { Image } from "astro:assets"

type Props = {
  locale: Locale
}

const { locale } = Astro.props
const dictionary = dictionaryFor(locale)
---

<Section tone="paper" title={dictionary.gallery.title} intro={dictionary.gallery.intro}>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      galleryPhotoKeys.map((key) => (
        <li class="overflow-hidden rounded-card border border-cream-200">
          <Image
            src={photos[key]}
            alt={dictionary.photoAlts[key]}
            width={420}
            height={560}
            widths={[280, 420, 560]}
            quality={74}
            class="aspect-[3/4] w-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </li>
      ))
    }
  </ul>
</Section>
